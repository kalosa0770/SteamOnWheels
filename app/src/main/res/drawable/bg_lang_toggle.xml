<?xml version="1.0" encoding="utf-8"?>
<!-- White pill container for the ENG/BEM language toggle, matching the
     web app's ".lang-toggle" (white bg, faint border, fully rounded).
     The active side (ENG or BEM) is distinguished by text color in code
     (see LessonActivity.updateLessonDisplay) rather than a background
     swap on the individual label, matching how it's already wired up. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#1A000000" />
    <corners android:radius="999dp" />

</shape>
